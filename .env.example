APP_ENV=development
API_PORT=8080
DATABASE_URL=postgres://lawoffice:lawoffice@localhost:5432/lawoffice?sslmode=disable
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me
METRICS_TOKEN=
STORAGE_PATH=./data/storage
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_TLS=true
S3_CREATE_BUCKET=false
UPLOAD_SCAN_MODE=off
CLAMAV_ADDRESS=127.0.0.1:3310
SMTP_MODE=off
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=LawOffice OS
SMTP_REQUIRE_TLS=true
JOB_ENCRYPTION_SECRET=
MAX_UPLOAD_MB=25
LOG_LEVEL=info
DEFAULT_LOCALE=pt-BR
DEFAULT_TIMEZONE=America/Sao_Paulo
MIGRATIONS_DIR=./migrations

OCR_MODE=off
OCR_ENDPOINT=
OCR_TOKEN=
OCR_LANGUAGE=pt-BR
OCR_MAX_INPUT_MB=25
OCR_MAX_PAGES=1000
OCR_MAX_CHARACTERS=5000000
OCR_TIMEOUT_SECONDS=90

# Optional private Matter AI Workspace. Disabled by default.
AI_MODE=off
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_CONTEXT_CHARACTERS=40000
AI_MAX_SOURCES=8
AI_TIMEOUT_SECONDS=60
