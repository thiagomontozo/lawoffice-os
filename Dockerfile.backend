FROM golang:1.24-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum* ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/lawoffice-api ./cmd/api

FROM alpine:3.21
RUN addgroup -S lawoffice && adduser -S -G lawoffice lawoffice && mkdir -p /app/migrations /data/storage && chown -R lawoffice:lawoffice /data
WORKDIR /app
COPY --from=build /out/lawoffice-api /usr/local/bin/lawoffice-api
COPY --from=build /src/migrations ./migrations
USER lawoffice
EXPOSE 8080
ENTRYPOINT ["lawoffice-api"]
